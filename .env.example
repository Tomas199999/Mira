# =============================================================================
# Mira — variables de entorno (plantilla). Copiar a .env y completar.
# NUNCA commitear .env con valores reales.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# URL del proyecto y clave anónima: seguras para el cliente móvil.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SOLO BACKEND. Esta clave saltea RLS por completo.
# Jamás debe aparecer en apps/mobile ni en ninguna variable con prefijo EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres (migraciones, jobs).
DATABASE_URL=

# --- IA de visión -------------------------------------------------------------
# SOLO BACKEND. El móvil nunca llama al proveedor de IA directamente.
ANTHROPIC_API_KEY=
VISION_MODEL_PRIMARY=claude-haiku-4-5
VISION_MODEL_ESCALATION=claude-opus-5

# --- Storage ------------------------------------------------------------------
STORAGE_BUCKET_SUBMISSIONS=submissions
STORAGE_BUCKET_AVATARS=avatars
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Push notifications -------------------------------------------------------
EXPO_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_SERVER_KEY=

# --- Anti-fraude / attestation ------------------------------------------------
APPLE_APP_ATTEST_TEAM_ID=
APPLE_APP_ATTEST_BUNDLE_ID=
GOOGLE_PLAY_INTEGRITY_PROJECT_NUMBER=
UPLOAD_TOKEN_SECRET=

# --- Jobs / cron --------------------------------------------------------------
# Secreto compartido que valida que un request de cron viene de Vercel.
CRON_SECRET=

# --- Cliente móvil (públicas — se embeben en el binario) ----------------------
# Sólo valores que no importa que sean visibles. Ver docs/SECURITY.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_ENV=development
